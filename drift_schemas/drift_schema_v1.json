  "fixed_sql": [
    {
      "name": "pokemon",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon\" (\"id\" INTEGER NOT NULL, \"national_dex_number\" INTEGER NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"image_url\" TEXT NULL, \"artwork_local_path\" TEXT NULL, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "type",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"type\" (\"id\" INTEGER NOT NULL, \"name\" TEXT NOT NULL UNIQUE, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pokemon_type",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon_type\" (\"pokemon_id\" INTEGER NOT NULL REFERENCES pokemon (id), \"type_id\" INTEGER NOT NULL REFERENCES type (id), \"slot\" INTEGER NOT NULL, PRIMARY KEY (\"pokemon_id\", \"type_id\"), UNIQUE (\"pokemon_id\", \"slot\"));"
        }
      ]
    },
    {
      "name": "favorite",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"favorite\" (\"pokemon_id\" INTEGER NOT NULL REFERENCES pokemon (id), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"pokemon_id\"));"
        }
      ]
    },
    {
      "name": "sync_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_metadata\" (\"resource_key\" TEXT NOT NULL, \"last_success_at\" INTEGER NULL, \"status\" TEXT NOT NULL DEFAULT 'pending', \"cursor_or_offset\" TEXT NULL, PRIMARY KEY (\"resource_key\"));"
        }
      ]
    },
    {
      "name": "pokemon_name_index",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX pokemon_name_index ON pokemon (name)"
        }
      ]
    }
